# systemd unit for chamber-agent (T-0011). Install: copy to /etc/systemd/system/, create /etc/chamber-agent.env (see chamber-agent.py header),
# adjust User= to the account that has Claude Code signed in, then: systemctl enable --now chamber-agent
[Unit]
Description=Chamber agent connector (Claude Code <-> Chamber)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=CHANGE_ME
EnvironmentFile=/etc/chamber-agent.env
Environment=PATH=/home/CHANGE_ME/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/CHANGE_ME
ExecStart=/usr/bin/python3 /opt/chamber-agent/chamber-agent.py
Restart=always
RestartSec=10
[Install]
WantedBy=multi-user.target
