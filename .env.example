# Chamber configuration — copy to `.env` (auto-loaded from the app dir) or set
# these in the systemd unit / your shell. Every value is optional.

# ── Core ──────────────────────────────────────────────────────────────
CHAMBER_PORT=4242
CHAMBER_HOST=127.0.0.1
CHAMBER_ACCENT=#39ff8f
# CHAMBER_DATA=./chamber.json
# CHAMBER_REVIEWS=./reviews.json

# ── Optional integrations (leave commented for a plain chat + code pad) ─
# CHAMBER_REPO_ROOT=/path/to/your/git/repo     # enables the Reviews git-diff feature
# CHAMBER_THEME_FILE=/path/to/theme.json       # {"color":"#rrggbb"} for live theming
# CHAMBER_TICKETS_FILE=/path/to/tickets.json   # Tickets tab (read)
# CHAMBER_TICKETS_CLI=/path/to/tickets-cli     # Tickets create/mutate
