# Chamber configuration — copy to `.env` (auto-loaded from the app dir) or set
# these in the systemd unit / your shell. Every value is optional.

# ── Core ──────────────────────────────────────────────────────────────
CHAMBER_PORT=4242
CHAMBER_HOST=127.0.0.1
CHAMBER_ACCENT=#00ff88
# CHAMBER_DATA=./chamber.json
# CHAMBER_REVIEWS=./reviews.json

# ── Authentication (REQUIRED before exposing on a network) ─────────────
# With no secret set, Chamber runs on loopback only and refuses to start on a
# non-loopback address. Set ONE of these to enable login:
# CHAMBER_PASSWORD=change-me-to-a-strong-secret
# CHAMBER_PASSWORD_HASH=salt:hash        # pre-hashed; keeps plaintext out (see INSTALL.md)
# CHAMBER_SECURE_COOKIE=1                 # set when served over HTTPS

# ── Optional integrations (leave commented for a plain chat + code pad) ─
# CHAMBER_REPO_ROOT=/path/to/your/git/repo     # enables the Reviews git-diff feature
# CHAMBER_THEME_FILE=/path/to/theme.json       # {"color":"#rrggbb"} for live theming
# CHAMBER_TICKETS_FILE=/path/to/tickets.json   # Tickets tab (read)
# CHAMBER_TICKETS_CLI=/path/to/chamber/tickets-cli.js   # Tickets create/mutate (the bundled CLI; absolute path)

# ── Self-hosting (SELF-HOSTING.md) ───────────────────────────────────────
# CHAMBER_ACCOUNTS=1            # workspaces, invites, roles, 2FA, agents, schedules, webhooks, audit, memory
# CHAMBER_SELF_HOSTED=1         # no Stripe: every workspace is entitled (hosted product uses CHAMBER_STRIPE_* instead)
# CHAMBER_PUBLIC_URL=https://chamber.example.com
# CHAMBER_INVITE_CODE=          # optional gate for creating new workspaces
# CHAMBER_SMTP_HOST= CHAMBER_SMTP_PORT=587 CHAMBER_SMTP_USER= CHAMBER_SMTP_PASSWORD= CHAMBER_SMTP_FROM=
# CHAMBER_REPO_URL=https://github.com/you/your-repo
